---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCE = [
  {
    date: "Feb 2024 - Mar 2025",
    title: "Backend Developer",
    company: "SeatGeek (Consultant - via ioet)",
    description:
        "Led project of a new admin interface for ticket fees, coordinating weekly with stakeholders. Improved backend performance by ~54% with FastAPI and Python, fixing N+1 queries and parallelizing operations. Worked with PostgreSQL, Kafka, and Docker to ensure smooth migrations and reliable, scalable APIs.",
  },
  {
    date: "Jan 2023 - Jan 2024",
    title: "Software Developer",
    company: "Warby Parker (Consultant - via ioet)",
    description:
        "Led the redesign of automated email delivery with Iterable and Narvar, ensuring timely customer communication. Contributed to backend refactoring with FastAPI and Tornado, adding new prescription checks for glasses and contacts. Improved test coverage, integrated third-party services, and collaborated with frontend engineers on React components.",
  },
  {
    date: "Jun 2022 - Jan 2023",
    title: "Software Developer Intern",
    company: "ioet",
    description:
        "Developed internal tools for desk booking, food preferences, and carpooling, improving team coordination. Contributed to backend development and maintenance, gaining hands-on experience with AWS (S3, EC2, Lambda) and minor Terraform changes. Restructured a backend service using Hexagonal Architecture to improve modularity and maintainability.",
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
